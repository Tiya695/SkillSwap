        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.token);",
                  "pm.collectionVariables.set(\"userId\", json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
